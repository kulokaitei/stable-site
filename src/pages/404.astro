---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Page not found — Ashgrove Stables" description="This page has wandered off. Head back to Ashgrove Stables." noindex>
  <Header />
  <main id="main" tabindex="-1" class="mx-auto flex min-h-svh max-w-[1600px] flex-col justify-center px-5 md:px-10">
    <p class="label text-muted"><span class="text-accent">404</span> — Not found</p>
    <h1 class="display mt-8 text-6xl md:text-8xl">This page has <em>wandered</em> off</h1>
    <a href="/" class="btn mt-12 self-start">Back to the stable</a>
  </main>
  <Footer />
</Base>
