---
/**
 * 06 — Contact. Bookend to the hero: as the section scrolls in, the head-turn frames
 * play in reverse (87 → 1) so the horse turns back to face you; then the text reveals.
 * Behaviour: src/scripts/contact.ts. Reduced motion: still frame 1, text visible.
 * data-own-reveal: the generic scroll reveals skip this section (it has its own timing).
 */
import { contact } from '../data/content';
import SectionMeta from './SectionMeta.astro';
import Title from './Title.astro';
---
<section id="contact" aria-labelledby="contact-title" data-section="06" data-contact data-own-reveal class="relative isolate flex min-h-svh flex-col justify-between overflow-hidden pb-14 pt-28 md:pb-16">
  <div class="absolute inset-0 -z-10 bg-bg">
    <canvas class="motion-only absolute inset-0 h-full w-full" data-contact-canvas role="img" aria-label={contact.head.alt}></canvas>
    <picture class="still-only">
      <source media="(max-width: 767px)" srcset={contact.head.mobile} width="1200" height="675" />
      <img
        src={contact.head.desktop}
        alt={contact.head.alt}
        width={contact.head.width}
        height={contact.head.height}
        loading="lazy"
        decoding="async"
        class="blend-bg absolute inset-0 h-full w-full object-cover"
      />
    </picture>
    <div class="absolute inset-x-0 bottom-0 h-3/4 bg-gradient-to-t from-bg via-bg/70 to-transparent" aria-hidden="true"></div>
  </div>

  <div class="mx-auto w-full max-w-[1600px] px-5 md:px-10">
    <SectionMeta number={contact.number} label={contact.label} />
  </div>

  <div class="mx-auto mt-[40svh] w-full max-w-[1600px] px-5 md:mt-0 md:px-10">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
      <Title id="contact-title" title={contact.title} class="text-6xl sm:text-7xl md:text-8xl lg:col-span-7 lg:text-9xl" />
      <div class="lg:col-span-4 lg:col-start-9" data-contact-intro>
        <p class="max-w-md leading-relaxed text-muted">{contact.intro}</p>
        <a href={contact.cta.href} class="btn mt-8">{contact.cta.label}</a>
      </div>
    </div>

    <address id="contact-details" class="rule mt-12 grid gap-8 pt-8 not-italic sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
      {contact.details.map((item) => (
        <div data-contact-item>
          <p class="label text-muted">{item.label}</p>
          {'href' in item && item.href
            ? <a href={item.href} class="mt-3 block text-lg transition-colors duration-700 hover:text-accent">{item.value}</a>
            : <p class="mt-3 text-lg">{item.value}</p>}
        </div>
      ))}
    </address>
  </div>
</section>
