---
/**
 * 05 — The horses. A list of names.
 * Later: on hover, the portrait follows the cursor.
 */
import { horses } from '../data/content';
import SectionMeta from './SectionMeta.astro';
import Title from './Title.astro';
---
<section id="horses" aria-labelledby="horses-title" data-section="05" class="relative mx-auto max-w-[1600px] px-5 py-24 md:px-10 md:py-40">
  <SectionMeta number={horses.number} label={horses.label} />

  <div class="mt-12 grid gap-8 md:mt-20 md:grid-cols-12 md:gap-10">
    <Title id="horses-title" title={horses.title} class="text-5xl md:col-span-7 md:text-7xl lg:text-8xl" />
    <p class="leading-relaxed text-muted md:col-span-4 md:col-start-9 md:pt-4">{horses.intro}</p>
  </div>

  <ol class="mt-16 md:mt-24" data-horse-list>
    {horses.list.map((horse, i) => (
      <li class="hairline group border-t last:border-b" data-horse data-portrait={horse.portrait ?? ''}>
        <div class="flex items-baseline gap-6 py-6 md:gap-10 md:py-8">
          <span class="label w-8 text-muted">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="display flex-1 text-4xl transition-colors duration-700 group-hover:text-accent md:text-6xl">{horse.name}</h3>
          <span class="label hidden text-muted sm:block">{horse.detail}</span>
        </div>
      </li>
    ))}
  </ol>

  <!-- Cursor-following portrait (positioned by the animation step). Placeholder until portraits exist. -->
  <div class="pointer-events-none fixed left-0 top-0 z-30 hidden aspect-[3/4] w-64 opacity-0" data-horse-portrait aria-hidden="true">
    <div class="hairline flex h-full w-full items-center justify-center border bg-bg">
      <span class="label text-muted">{horses.portraitPlaceholder}</span>
    </div>
  </div>
</section>
