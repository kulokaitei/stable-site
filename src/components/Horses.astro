---
/**
 * 05 — The horses. Large names, hairlines between rows, details on the right.
 * Each row is a <details>: click/tap (or Enter) on a name opens it to show that horse's
 * portrait and description — works without JS. Behaviour: src/scripts/horses.ts.
 */
import { horses } from '../data/content';
import SectionMeta from './SectionMeta.astro';
import Title from './Title.astro';
import Photo from './Photo.astro';
const { width, height } = horses.portraitSize;
---
<section id="horses" aria-labelledby="horses-title" data-section="05" data-horses class="relative mx-auto max-w-[1600px] px-5 py-24 md:px-10 md:py-40">
  <SectionMeta number={horses.number} label={horses.label} />

  <div class="mt-12 grid gap-8 md:mt-20 md:grid-cols-12 md:gap-10">
    <Title id="horses-title" title={horses.title} class="text-5xl md:col-span-7 md:text-7xl lg:text-8xl" />
    <p class="leading-relaxed text-muted md:col-span-4 md:col-start-9 md:pt-4">{horses.intro}</p>
  </div>

  <ol class="mt-16 md:mt-24" data-horse-list>
    {horses.list.map((horse, i) => (
      <li class="rule" data-horse data-index={i}>
        <details class="group" data-horse-details>
          <summary class="flex cursor-pointer list-none items-baseline gap-5 py-6 md:gap-10 md:py-8 [&::-webkit-details-marker]:hidden">
            <span class="label w-8 shrink-0 text-muted">{String(i + 1).padStart(2, '0')}</span>
            <h3 data-split class="display flex-1 text-5xl leading-none transition-colors duration-700 group-hover:text-accent group-open:text-accent md:text-7xl lg:text-8xl">
              {horse.name}
            </h3>
            <span class="label hidden text-right text-muted sm:block">{horse.detail}</span>
            <!-- plus → cross when open -->
            <span class="relative size-3 shrink-0 self-center transition-transform duration-700 ease-[cubic-bezier(0.215,0.61,0.355,1)] group-open:rotate-45 sm:hidden" aria-hidden="true">
              <span class="absolute inset-x-0 top-1/2 h-px bg-ink"></span>
              <span class="absolute inset-y-0 left-1/2 w-px bg-ink"></span>
            </span>
          </summary>
          <div class="grid gap-6 pb-12 sm:grid-cols-12 sm:gap-10" data-horse-panel>
            {horse.portrait && (
              <div class="aspect-[4/5] w-full max-w-sm overflow-hidden bg-bg sm:col-span-5 sm:col-start-2 lg:col-span-3 lg:col-start-2">
                <Photo
                  src={horse.portrait}
                  alt={horse.portraitAlt}
                  width={width}
                  height={height}
                  sizes="(min-width: 1024px) 25vw, (min-width: 640px) 40vw, 90vw"
                  class="blend-bg h-full w-full object-cover"
                  data-horse-panel-img
                />
              </div>
            )}
            <div class:list={['sm:col-span-5 sm:self-end', horse.portrait ? 'sm:col-start-7 lg:col-start-6 lg:col-span-4' : 'sm:col-start-2']}>
              <p class="label text-accent sm:hidden">{horse.detail}</p>
              <p class="mt-4 max-w-md text-lg leading-relaxed text-muted sm:mt-0">{horse.description}</p>
            </div>
          </div>
        </details>
      </li>
    ))}
  </ol>
  <div class="rule" aria-hidden="true"></div>

</section>
