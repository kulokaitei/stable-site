---
/** Display heading with one italic accent word. */
interface Props {
  title: { before: string; accent: string; after: string };
  id?: string;
  as?: 'h1' | 'h2';
  class?: string;
}
const { title, id, as: Tag = 'h2', class: className = '' } = Astro.props;
---
<Tag id={id} data-split class:list={['display text-balance', className]}>
  {title.before}{' '}<em>{title.accent}</em>{' '}{title.after}
</Tag>
