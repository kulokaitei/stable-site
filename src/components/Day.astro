---
/**
 * 04 — A day at the stable. Timeline 06:00 → 21:00.
 * Now: a native horizontal scroller (swipe / shift+scroll).
 * Later: pinned and driven by vertical scroll.
 */
import { day } from '../data/content';
import SectionMeta from './SectionMeta.astro';
import Title from './Title.astro';
---
<section id="day" aria-labelledby="day-title" data-section="04" class="py-24 md:py-40">
  <div class="mx-auto max-w-[1600px] px-5 md:px-10">
    <SectionMeta number={day.number} label={day.label} />
    <Title id="day-title" title={day.title} class="mt-12 max-w-[14ch] text-5xl md:mt-20 md:text-7xl lg:text-8xl" />
  </div>

  <div class="mt-16 overflow-x-auto md:mt-24" data-day-viewport>
    <ol class="flex w-max gap-5 px-5 pb-6 md:gap-10 md:px-10" data-day-track>
      {day.entries.map((entry) => (
        <li class="w-[80vw] shrink-0 sm:w-[60vw] lg:w-[42vw]">
          <div class="hairline flex items-baseline justify-between border-t pt-4">
            <time class="display text-5xl text-accent md:text-6xl" datetime={entry.time}>{entry.time}</time>
            <h3 class="label text-muted">{entry.title}</h3>
          </div>
          <div class="mt-6 aspect-[3/2] overflow-hidden">
            <img
              src={entry.image.src}
              alt={entry.image.alt}
              width={entry.image.width}
              height={entry.image.height}
              loading="lazy"
              decoding="async"
              class:list={['h-full w-full object-cover', entry.darken && 'img-darken']}
            />
          </div>
          <p class="mt-6 max-w-sm leading-relaxed text-muted">{entry.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
