---
/**
 * 01 — Hero.
 * The horse is completely still (frame 1) until the visitor scrolls.
 * The section is pinned; scroll position maps 1:1 to the head-turn frames
 * (public/frames/head). Scrolling back up plays the frames back at the same speed.
 * Reduced motion: a still image, no pinning.
 */
import { hero } from '../data/content';
import Title from './Title.astro';
---
<section id="top" aria-labelledby="hero-title" data-section="01" data-hero class="relative isolate flex h-svh min-h-[560px] flex-col justify-end overflow-hidden">
  <div class="absolute inset-0 -z-10">
    <canvas class="motion-only absolute inset-0 h-full w-full" data-head-canvas role="img" aria-label={hero.media.alt}></canvas>
    <img
      class="still-only h-full w-full object-cover object-top"
      src={hero.media.still}
      alt={hero.media.alt}
      width="1200"
      height="1800"
      decoding="async"
      fetchpriority="high"
    />
    <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-bg via-bg/60 to-transparent" aria-hidden="true"></div>
  </div>

  <div class="mx-auto w-full max-w-[1600px] px-5 pb-10 pt-32 md:px-10 md:pb-14" data-hero-copy>
    <p class="label mb-6 text-muted"><span class="text-accent">{hero.number}</span> — {hero.label}</p>
    <Title as="h1" id="hero-title" title={hero.title} class="max-w-[12ch] text-6xl sm:text-7xl md:text-8xl lg:text-9xl" />
    <div class="hairline mt-10 flex flex-col gap-8 border-t pt-6 md:flex-row md:items-end md:justify-between">
      <p class="max-w-md text-base leading-relaxed text-muted">{hero.intro}</p>
      <div class="flex items-center gap-8">
        <span class="label text-muted" aria-hidden="true">{hero.scrollHint} ↓</span>
        <a href={hero.cta.href} class="btn">{hero.cta.label}</a>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const FRAME_COUNT = 87;
  const BG = '#050404';
  const section = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-head-canvas]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (section && canvas && !reduced) {
    const ctx = canvas.getContext('2d')!;
    const folder = window.innerWidth < 768 ? 'head-mobile' : 'head';
    const frameSrc = (i: number) => `/frames/${folder}/${String(i + 1).padStart(3, '0')}.webp`;
    const images: HTMLImageElement[] = [];
    const state = { frame: 0 };
    let drawn = -1;

    const isReady = (img?: HTMLImageElement) => !!img && img.complete && img.naturalWidth > 0;

    // While frames are still loading, show the closest one that is ready.
    const nearestReady = (i: number) => {
      for (let d = 0; d < FRAME_COUNT; d++) {
        if (isReady(images[i - d])) return images[i - d];
        if (isReady(images[i + d])) return images[i + d];
      }
      return null;
    };

    const render = (force = false) => {
      const i = Math.round(state.frame);
      if (!force && i === drawn) return;
      const img = nearestReady(i);
      if (!img) return;
      drawn = i;

      const cw = canvas.width;
      const ch = canvas.height;
      const iw = img.naturalWidth;
      const ih = img.naturalHeight;
      let s: number, dx: number, dy: number;
      if (cw / ch >= 1) {
        // Landscape: cover the screen.
        s = Math.max(cw / iw, ch / ih);
        dx = (cw - iw * s) / 2;
        dy = (ch - ih * s) / 2;
      } else {
        // Portrait (phones): keep the whole head in view, near the top.
        s = cw / (iw * 0.55);
        dx = cw / 2 - iw * 0.53 * s;
        dy = ch * 0.08;
      }

      ctx.globalCompositeOperation = 'source-over';
      ctx.fillStyle = BG;
      ctx.fillRect(0, 0, cw, ch);
      // 'lighten' turns the video's pure black into exactly the site background.
      ctx.globalCompositeOperation = 'lighten';
      ctx.drawImage(img, dx, dy, iw * s, ih * s);
    };

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(canvas.clientWidth * dpr);
      canvas.height = Math.round(canvas.clientHeight * dpr);
      render(true);
    };

    // Frame 1 first, then the rest in order.
    for (let i = 0; i < FRAME_COUNT; i++) {
      const img = new Image();
      img.decoding = 'async';
      img.onload = () => {
        if (i === 0 || Math.abs(i - state.frame) < 2) render(true);
      };
      img.src = frameSrc(i);
      images[i] = img;
    }

    resize();
    window.addEventListener('resize', resize);

    // Pinned for 1.5 screens of scrolling. scrub: true = the frame follows the
    // scroll position exactly, forwards and backwards, with no extra delay.
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: '+=150%',
        pin: true,
        scrub: true,
        anticipatePin: 1,
      },
    });
    tl.to(state, { frame: FRAME_COUNT - 1, ease: 'none', duration: 1, onUpdate: () => render() }, 0);
    tl.to('[data-hero-copy]', { autoAlpha: 0, y: -40, ease: 'none', duration: 0.3 }, 0);
  }
</script>
