---
/**
 * 01 — Hero. Still on frame 1 until you scroll; pinned scroll turns the head (canvas frame sequence).
 * Behaviour lives in src/scripts/hero.ts. Reduced motion: hero-still.jpg, no pin.
 */
import { hero } from '../data/content';
import Title from './Title.astro';
import { webpSrcset } from '../data/images';
---
<section id="top" aria-labelledby="hero-title" data-section="01" data-hero class="relative isolate flex h-svh min-h-[560px] flex-col justify-end overflow-hidden">
  <div class="absolute inset-0 -z-10 bg-bg" data-hero-media>
    <canvas class="motion-only absolute inset-0 h-full w-full" data-head-canvas role="img" aria-label={hero.media.alt}></canvas>
    <!-- Reduced-motion still. With motion on, the <source> below matches and serves a 1×1 pixel,
         so the 190 KB photo is only downloaded by visitors who actually see it. -->
    <picture class="still-only block h-full w-full">
      <source media="(prefers-reduced-motion: no-preference)" srcset="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" />
      <source type="image/webp" srcset={webpSrcset(hero.media.still)!} sizes="100vw" />
      <img
        class="h-full w-full object-cover object-top"
        src={hero.media.still}
        alt={hero.media.alt}
        width="1200"
        height="1800"
        decoding="async"
      />
    </picture>
    <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-bg via-bg/60 to-transparent" aria-hidden="true"></div>
  </div>

  <!-- Captions while the head turns (scripts/hero.ts). Decorative repeat of the section 02 copy,
       so hidden from screen readers; not shown at all with reduced motion. -->
  <div class="motion-only pointer-events-none absolute inset-x-0 bottom-0" aria-hidden="true" data-hero-captions>
    <div class="mx-auto w-full max-w-[1600px] px-5 pb-16 md:px-10 md:pb-20">
      <div class="grid items-end">
        {hero.captions.map((c, i) => (
          <div class="opacity-0 [grid-area:1/1]" data-hero-caption>
            <p class="label text-muted"><span class="text-accent">{String(i + 1).padStart(2, '0')}</span> — {c.label}</p>
            <p class="display mt-5 max-w-[15ch] text-4xl sm:text-5xl md:text-6xl lg:text-7xl">
              {c.before}{' '}<em>{c.accent}</em>{c.after}
            </p>
          </div>
        ))}
      </div>
      <div class="relative mt-10 h-px w-[200px] bg-line opacity-0" data-hero-progress>
        <div class="absolute inset-0 origin-left bg-accent" style="transform: scaleX(0)" data-hero-progress-fill></div>
      </div>
    </div>
  </div>

  <div class="mx-auto w-full max-w-[1600px] px-5 pb-10 pt-32 md:px-10 md:pb-14" data-hero-copy>
    <p class="label mb-6 text-muted"><span class="text-accent">{hero.number}</span> — {hero.label}</p>
    <Title as="h1" id="hero-title" title={hero.title} class="max-w-[12ch] text-6xl sm:text-7xl md:text-8xl lg:text-9xl" />
    <div class="rule mt-10 flex flex-col gap-8 pt-6 md:flex-row md:items-end md:justify-between">
      <p class="max-w-md text-base leading-relaxed text-muted">{hero.intro}</p>
      <div class="flex items-center gap-8">
        <span class="label text-muted" aria-hidden="true">{hero.scrollHint} ↓</span>
        <a href={hero.cta.href} class="btn">{hero.cta.label}</a>
      </div>
    </div>
  </div>
</section>
