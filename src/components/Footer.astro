---
import { site, footer, nav } from '../data/content';
// On pages other than the home page, section links point back to the home page.
const prefix = Astro.url.pathname === '/' ? '' : '/';
---
<footer class="mx-auto max-w-[1600px] px-5 pb-10 md:px-10">
  <div class="rule grid gap-10 pt-10 md:grid-cols-12">
    <div class="md:col-span-5">
      <p class="display text-3xl">{site.name}</p>
      <p class="label mt-4 text-muted">{footer.tagline}</p>
    </div>
    <nav aria-label="Footer" class="md:col-span-4">
      <ul class="grid grid-cols-2 gap-4">
        {nav.map((item) => <li><a href={prefix + item.href} class="label text-muted hover:text-ink">{item.label}</a></li>)}
      </ul>
    </nav>
    <ul class="flex flex-col gap-4 md:col-span-3 md:items-end">
      {footer.social.map((s) => (
        <li>{s.href ? <a href={s.href} class="label text-muted hover:text-ink">{s.label}</a> : <span class="label text-muted">{s.label}</span>}</li>
      ))}
    </ul>
  </div>
  <div class="rule mt-10 flex items-center justify-between pt-6">
    <div class="flex flex-wrap items-center gap-x-8 gap-y-3">
      <p class="label text-muted">{footer.copyright}</p>
      <a href={footer.privacy.href} class="label text-muted hover:text-ink">{footer.privacy.label}</a>
    </div>
    <a href={prefix + '#top'} class="label text-muted hover:text-ink">{footer.backToTop} ↑</a>
  </div>
</footer>
